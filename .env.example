# KOIB RAG v4.11.0 — production profile
# Сценарий: индексируем документы на ПК, переносим ./output на VPS, запускаем inference.

KOIB_VERSION=4.11.0
KOIB_DOCS_DIR=./data/docs
KOIB_ARTIFACTS_DIR=./data/artifacts
KOIB_OUTPUT_DIR=./output

# === LLM provider: gigachat | openai | local ===
LLM_PROVIDER=gigachat

# GigaChat
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_TEMPERATURE=0.2
GIGACHAT_MAX_TOKENS=1536
GIGACHAT_TIMEOUT=45
GIGACHAT_VERIFY_SSL=false

# OpenAI, если LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=1536

# Local LLM, если LLM_PROVIDER=local (Ollama)
LOCAL_LLM_MODEL=IlyaGusev/saiga_mistral_7b
LOCAL_LLM_URL=http://localhost:11434

# === Embeddings ===
# ВАЖНО: одинаковая embedding-модель на машине индексации и VPS.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PASSAGE_PREFIX="passage: "
QUERY_PREFIX="query: "

# === Chunking ===
TEXT_CHUNK_SIZE=800
TEXT_CHUNK_OVERLAP=80
MIN_CHUNK_LENGTH=50

# === Retrieval ===
VECTOR_SEARCH_K=15
BM25_SEARCH_K=10
FINAL_TOP_K=4
HYBRID_ALPHA=0.6
BM25_USE_STOPWORDS=true
BM25_USE_LEMMATIZATION=true
USE_HYDE=false
USE_USHAPED_CONTEXT=true

# Reranker: для 2GB VPS лучше false; включайте на более сильном сервере.
USE_RERANKER=false
RERANKER_MODEL=DiTy/ru-reranker-base
USE_ONNX_RERANKER=false

# === Parsing ===
# Старые JSONL-артефакты chunks/docstore/bm25 кладите в KOIB_ARTIFACTS_DIR и запускайте --ingest-artifacts.
# bm25 содержит лемматизированный текст и по умолчанию не импортируется как пользовательский контент.
ARTIFACT_ALLOW_BM25_FALLBACK=false
ARTIFACT_MIN_CONTENT_CHARS=30
OCR_DPI=150
OCR_MIN_TEXT_CHARS=50
MIN_IMAGE_WIDTH=80
MIN_IMAGE_HEIGHT=80

# === Validation ===
VALIDATION_IGNORE_QUOTES=true
VALIDATION_USE_LLM_JUDGE=false
VALIDATION_CHECK_CITATIONS=true
UNCERTAINTY_MIN_LENGTH=50

# === Semantic cache ===
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_MAX_CANDIDATES=1000

# === API Server ===
API_HOST=0.0.0.0
API_PORT=8000
MAX_CONCURRENT_GENERATIONS=2

# === VK Bot ===
VK_CONFIRM_CODE=12345678
VK_GROUP_ID=
VK_SECRET_KEY=
VK_ACCESS_TOKEN=
VK_API_VERSION=5.131
VK_RATE_LIMIT_PER_MINUTE=20
VK_GLOBAL_RATE_LIMIT_PER_MINUTE=120
VK_MAX_INCOMING_CHARS=1500
VK_MAX_OUTGOING_CHARS=3900
VK_OUTBOUND_TIMEOUT=10
VK_DEDUP_TTL_SECONDS=86400
VK_SEND_TYPING=true
# По умолчанию бот отвечает только в личных сообщениях сообщества.
# Для бесед поставьте true и добавьте бота в чат.
VK_REPLY_IN_GROUP_CHATS=false
VK_BOT_MENTION_ALIASES=коиб,koib
# Через запятую: VK user IDs администраторов, которым доступна /health.
VK_ADMIN_IDS=
VK_ERROR_MESSAGE=Не удалось подготовить ответ. Проверьте подключение к серверу и при необходимости обратитесь к администратору системы.
PROCEDURAL_REMINDER_ENABLED=true

# === Indexing profiles ===
# VPS / CPU / 2GB RAM
INDEXING_BATCH_SIZE=64
INDEXING_FLUSH_THRESHOLD=2000
INDEXING_DEVICE=cpu
INGEST_MAX_WORKERS=2
HF_OFFLINE_MODE=false

# PC / GPU profile example:
# OCR_DPI=300
# INDEXING_BATCH_SIZE=1024
# INDEXING_FLUSH_THRESHOLD=50000
# INDEXING_DEVICE=auto
# INGEST_MAX_WORKERS=8
